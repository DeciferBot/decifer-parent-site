# Early-access form: email notification
# Get your key from https://resend.com/api-keys
# Without this, form submissions are logged to Vercel Function logs only.
RESEND_API_KEY=

# Email address to receive early-access notifications.
# Set to any working inbox you control (e.g. your personal email until hello@decifer.io is ready).
RESEND_NOTIFY_EMAIL=

# Sending address for notification emails.
# Must be a verified domain in Resend (https://resend.com/domains).
# Leave blank to use Resend's shared test address (onboarding@resend.dev) while testing.
# Set to e.g. "DECIFER <noreply@decifer.io>" once decifer.io is verified in Resend.
RESEND_FROM=

# Lead storage: Supabase (optional but strongly recommended)
# Apply supabase/leads.sql to the project first. Without these, enquiries and
# early-access signups are only written to Vercel Function logs.
# SUPABASE_URL is server-only. Never expose the service role key as NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing client IPs in the leads table (any long random string).
LEAD_IP_SALT=

# Booking link shown on /contact and in confirmation emails (e.g. Cal.com).
NEXT_PUBLIC_BOOKING_URL=

# Google Analytics 4 measurement ID (optional). Read by src/app/layout.tsx.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (optional). Read by src/app/layout.tsx.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Stripe (https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
